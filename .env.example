# thalos-shopify — CLI configuration
# Copy to `.env` and fill your values.  Never commit `.env`.

# ── Source store (read-only; NEVER written to) ──────────────────────────
# The store slug only — no `.myshopify.com` suffix.  e.g. for
# `my-source.myshopify.com` put `my-source`.
SHOPIFY_SOURCE_STORE=my-source
SHOPIFY_SOURCE_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Destination store (the clone target) ────────────────────────────────
SHOPIFY_DEST_STORE=my-dest
SHOPIFY_DEST_TOKEN=shpat_yyyyyyyyyyyyyyyyyyyyyyyyyyyyyyyy

# ── Shopify Admin API version ───────────────────────────────────────────
SHOPIFY_API_VERSION=2026-01

# ── Snapshot directory (sync state, id maps, history, HTML report) ──────
SNAPSHOT_DIR=./snapshot_store

# ── Workers: 0 = auto-detect from destination plan. Override if needed. ─
MAX_WORKERS=0

# ── Global dry-run / delete-orphans switches (also available as CLI flags)
DRY_RUN=false
DELETE_ORPHANS=false

# ── Incremental: only sync orders placed after this ISO date ────────────
# Leave blank for a full sync.
# ORDERS_SINCE=2025-01-01
